end

if Controls then
  local rapidjson = require("rapidjson")

  local STAGE_CHOICES = { "TIMER", "SVG", "ICONDATA" }
  local STAGE_VALUES = {
    TIMER = true,
    SVG = true,
    ICONDATA = true
  }
  local TIMER_INTERVAL = 1 / 30
  local MOTION_MIN = 0
  local MOTION_MAX = 300
  local MOTION_STEP = 4

  local activeStage = "TIMER"
  local motionX = MOTION_MIN
  local motionDirection = 1
  local tickCount = 0
  local measurementTicks = 0
  local measurementStartedAt = 0
  local lastSvgBytes = 0

  -- Reused exactly as in the known-good compatibility probe.
  RuntimeProbeLegend = {
    DrawChrome = false,
    IconData = ""
  }

  -- Q-SYS timer objects must remain globally scoped so Lua GC cannot collect them.
  RuntimeProbeTimer = Timer.New()

  local function SelectedStage()
    local selected = Controls.Stage.String
    if STAGE_VALUES[selected] == nil then
      selected = "TIMER"
      Controls.Stage.String = selected
    end
    return selected
  end

  local function BuildTinySvg()
    return "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 480\" width=\"320\" height=\"480\">" ..
      "<rect width=\"320\" height=\"480\" fill=\"#07101f\"/>" ..
      "<rect x=\"" .. tostring(motionX) .. "\" y=\"220\" width=\"20\" height=\"20\" fill=\"#46e6e1\"/>" ..
      "</svg>"
  end

  local function AssignIconData(svg)
    local encodedSvg = Crypto.Base64Encode(svg)
    RuntimeProbeLegend.IconData = encodedSvg
    Controls.Viewport.Legend = rapidjson.encode(RuntimeProbeLegend)
  end

  local function UpdateMotion()
    motionX = motionX + motionDirection * MOTION_STEP
    if motionX >= MOTION_MAX then
      motionX = MOTION_MAX
      motionDirection = -1
    elseif motionX <= MOTION_MIN then
      motionX = MOTION_MIN
      motionDirection = 1
    end
  end

  local function RenderInitialFrame()
    lastSvgBytes = 0
    if activeStage == "SVG" then
      local svg = BuildTinySvg()
      lastSvgBytes = #svg
    elseif activeStage == "ICONDATA" then
      local svg = BuildTinySvg()
      lastSvgBytes = #svg
      AssignIconData(svg)
    end
    Controls.SvgBytes.String = tostring(lastSvgBytes)
  end

  local function ResetCounters()
    motionX = MOTION_MIN
    motionDirection = 1
    tickCount = 0
    measurementTicks = 0
    measurementStartedAt = Timer.Now()
    lastSvgBytes = 0
    Controls.TickCount.String = "0"
    Controls.MeasuredHz.String = "MEASURING"
    Controls.SvgBytes.String = "0"
  end

  local function StartProbe()
    RuntimeProbeTimer:Stop()
    activeStage = SelectedStage()
    ResetCounters()
    RenderInitialFrame()
    Controls.Status.String = "RUNNING / " .. activeStage
    RuntimeProbeTimer:Start(TIMER_INTERVAL)
  end

  local function StopProbe()
    RuntimeProbeTimer:Stop()
    Controls.Status.String = "STOPPED"
  end

  local function ApplyStageChange()
    activeStage = SelectedStage()
    if Controls.Run.Boolean then
      StartProbe()
    else
      RuntimeProbeTimer:Stop()
      ResetCounters()
      Controls.MeasuredHz.String = "0.0 Hz"
      Controls.Status.String = "IDLE / " .. activeStage
    end
  end

  RuntimeProbeTimer.EventHandler = function()
    if activeStage == "SVG" then
      UpdateMotion()
      local svg = BuildTinySvg()
      lastSvgBytes = #svg
    elseif activeStage == "ICONDATA" then
      UpdateMotion()
      local svg = BuildTinySvg()
      lastSvgBytes = #svg
      AssignIconData(svg)
    end

    tickCount = tickCount + 1
    measurementTicks = measurementTicks + 1

    local now = Timer.Now()
    local elapsed = now - measurementStartedAt
    if elapsed >= 1 then
      Controls.TickCount.String = tostring(tickCount)
      Controls.MeasuredHz.String = string.format("%.1f Hz", measurementTicks / elapsed)
      Controls.SvgBytes.String = tostring(lastSvgBytes)
      measurementTicks = 0
      measurementStartedAt = now
    end
  end

  Controls.Run.EventHandler = function(control)
    if control.Boolean then
      StartProbe()
    else
      StopProbe()
    end
  end

  Controls.Stage.EventHandler = function()
    ApplyStageChange()
  end

  Controls.Stage.Choices = STAGE_CHOICES
  activeStage = SelectedStage()
  RuntimeProbeTimer:Stop()
  Controls.Run.Boolean = false
  Controls.Status.String = "IDLE / " .. activeStage
  Controls.TickCount.String = "0"
  Controls.MeasuredHz.String = "0.0 Hz"
  Controls.SvgBytes.String = "0"
end
