  local function AssetAvailable(assetId)
    local asset = ASSETS[assetId]
    return asset ~= nil and asset.Available
  end

  local function AppendDefinitionUse(parts, definitionId, x, y)
    parts[#parts + 1] = "<use href=\"#" .. definitionId .. "\" x=\"" ..
      tostring(math.floor(x)) .. "\" y=\"" .. tostring(math.floor(y)) .. "\"/>"
  end

  local function AppendTranslatedUse(parts, definitionId, x, y)
    parts[#parts + 1] = "<use href=\"#" .. definitionId ..
      "\" transform=\"translate(" .. tostring(math.floor(x)) .. " " ..
      tostring(math.floor(y)) .. ")\"/>"
  end

  local function AppendSpriteUse(parts, assetId, fallbackId, x, y)
    if AssetAvailable(assetId) then
      AppendDefinitionUse(parts, assetId, x, y)
    else
      AppendDefinitionUse(parts, fallbackId, x, y)
    end
  end

  local function ResolvePlayerDefinition(direction)
    if direction == "left" and AssetAvailable("player_left") then
      return "player_left"
    end
    if direction == "right" and AssetAvailable("player_right") then
      return "player_right"
    end
    if AssetAvailable("player_idle") then
      return "player_idle"
    end
    return "fallback_player"
  end

  local function AssetAvailabilitySummary()
    return tostring(availableAssetCount) .. "/" .. tostring(#ASSET_MANIFEST) .. " ASSETS"
  end

  local function MissingAssetList()
    return table.concat(MISSING_ASSET_PATHS, ", ")
  end
  local function CreateGameState()
    local state = {
      running = false,
      paused = false,
      score = 0,
      time = 0,
      ticks = 0,
      backgroundOffset = 0,
      player = {},
      enemies = {},
      playerBullets = {},
      enemyBullets = {},
      explosions = {}
    }

    for index = 1, GAME_CONFIG.MaxEnemies do
      state.enemies[index] = {
        active = false,
        x = 0,
        y = 0,
        width = GAME_CONFIG.EnemyWidth,
        height = GAME_CONFIG.EnemyHeight,
        slot = index,
        cycle = 0
      }
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      state.playerBullets[index] = {
        active = false,
        x = 0,
        y = 0,
        width = GAME_CONFIG.PlayerBulletWidth,
        height = GAME_CONFIG.PlayerBulletHeight
      }
    end

    for index = 1, GAME_CONFIG.MaxExplosions do
      state.explosions[index] = {
        active = false,
        x = 0,
        y = 0,
        frame = 1,
        ticksRemaining = 0
      }
    end

    return state
  end

  local function ResetGameState(state)
    state.running = false
    state.paused = false
    state.score = 0
    state.time = 0
    state.ticks = 0
    state.backgroundOffset = 0

    state.player.x = math.floor((GAME_CONFIG.LogicalWidth - GAME_CONFIG.PlayerWidth) / 2)
    state.player.y = GAME_CONFIG.PlayerStartY
    state.player.width = GAME_CONFIG.PlayerWidth
    state.player.height = GAME_CONFIG.PlayerHeight
    state.player.direction = "idle"
    state.player.fireCooldown = 0

    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      enemy.active = false
      enemy.x = 0
      enemy.y = 0
      enemy.cycle = 0
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      bullet.active = false
      bullet.x = 0
      bullet.y = 0
    end

    for index = 1, GAME_CONFIG.MaxExplosions do
      local explosion = state.explosions[index]
      explosion.active = false
      explosion.x = 0
      explosion.y = 0
      explosion.frame = 1
      explosion.ticksRemaining = 0
    end
  end
  local function ClampInteger(value, minimum, maximum)
    if value < minimum then
      return minimum
    end
    if value > maximum then
      return maximum
    end
    return math.floor(value)
  end

  local function UpdatePlayer(state, leftPressed, rightPressed, upPressed, downPressed)
    local player = state.player
    local horizontal = 0
    local vertical = 0

    if leftPressed then
      horizontal = horizontal - 1
    end
    if rightPressed then
      horizontal = horizontal + 1
    end
    if upPressed then
      vertical = vertical - 1
    end
    if downPressed then
      vertical = vertical + 1
    end

    local movement = GAME_CONFIG.PlayerSpeed
    if horizontal ~= 0 and vertical ~= 0 then
      movement = GAME_CONFIG.PlayerDiagonalSpeed
    end

    player.x = ClampInteger(
      player.x + horizontal * movement,
      0,
      GAME_CONFIG.LogicalWidth - player.width
    )
    player.y = ClampInteger(
      player.y + vertical * movement,
      0,
      GAME_CONFIG.LogicalHeight - player.height
    )

    if horizontal < 0 then
      player.direction = "left"
    elseif horizontal > 0 then
      player.direction = "right"
    else
      player.direction = "idle"
    end

    if player.fireCooldown > 0 then
      player.fireCooldown = player.fireCooldown - 1
    end
  end
  local function FirePlayerBullet(state)
    local player = state.player
    if player.fireCooldown > 0 then
      return false
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      if not bullet.active then
        bullet.active = true
        bullet.x = math.floor(player.x + (player.width - bullet.width) / 2)
        bullet.y = player.y - bullet.height
        player.fireCooldown = GAME_CONFIG.FireIntervalTicks
        return true
      end
    end

    return false
  end

  local function UpdatePlayerBullets(state)
    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      if bullet.active then
        bullet.y = bullet.y - GAME_CONFIG.PlayerBulletSpeed
        if bullet.y + bullet.height < 0 then
          bullet.active = false
        end
      end
    end
  end

  local function CountActivePlayerBullets(state)
    local count = 0
    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      if state.playerBullets[index].active then
        count = count + 1
      end
    end
    return count
  end
  local function RecycleEnemy(enemy)
    enemy.cycle = enemy.cycle + 1
    local horizontalRange = GAME_CONFIG.LogicalWidth - enemy.width
    enemy.x = (enemy.slot * 53 + enemy.cycle * 29) % horizontalRange
    enemy.y = -enemy.height - ((enemy.slot * 37 + enemy.cycle * 11) % 160)
    enemy.active = true
  end

  local function ResetEnemies(state)
    local horizontalRange = GAME_CONFIG.LogicalWidth - GAME_CONFIG.EnemyWidth

    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      enemy.active = index <= GAME_CONFIG.InitialEnemyCount
      enemy.cycle = 0
      enemy.x = ((index - 1) * 73 + 20) % horizontalRange
      enemy.y = 48 - (index - 1) * 96
    end
  end

  local function UpdateEnemies(state)
    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      if enemy.active then
        enemy.y = enemy.y + GAME_CONFIG.EnemySpeed
        if enemy.y > GAME_CONFIG.LogicalHeight then
          RecycleEnemy(enemy)
        end
      end
    end
  end

  local function CountActiveEnemies(state)
    local count = 0
    for index = 1, GAME_CONFIG.MaxEnemies do
      if state.enemies[index].active then
        count = count + 1
      end
    end
    return count
  end
  local function BoxesOverlap(first, second)
    return first.x < second.x + second.width and
      first.x + first.width > second.x and
      first.y < second.y + second.height and
      first.y + first.height > second.y
  end

  local function CheckPlayerBulletEnemyCollisions(state)
    for bulletIndex = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[bulletIndex]
      if bullet.active then
        for enemyIndex = 1, GAME_CONFIG.MaxEnemies do
          local enemy = state.enemies[enemyIndex]
          if enemy.active and BoxesOverlap(bullet, enemy) then
            bullet.active = false
            RecycleEnemy(enemy)
            state.score = state.score + GAME_CONFIG.EnemyScore
            break
          end
        end
      end
    end
  end
  local SVG_ROOT_OPEN =
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 480\" width=\"320\" height=\"480\" shape-rendering=\"crispEdges\">"

  -- Asset and fallback definitions are assembled once when the plugin runtime
  -- initializes. Per-frame serialization only emits positions, state, and HUD.
  local GAME_SVG_PREFIX = SVG_ROOT_OPEN .. "<defs>" .. STATIC_RENDER_DEFINITIONS ..
    "</defs><rect width=\"320\" height=\"480\" fill=\"#07101f\"/>"

  local TIMER_ONLY_SVG = SVG_ROOT_OPEN ..
    "<rect width=\"320\" height=\"480\" fill=\"#07101f\"/>" ..
    "<text x=\"160\" y=\"224\" fill=\"#46e6e1\" font-family=\"monospace\" font-size=\"16\" text-anchor=\"middle\">TIMER ONLY</text>" ..
    "<text x=\"160\" y=\"248\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"10\" text-anchor=\"middle\">VIEWPORT HELD STATIC</text></svg>"

  local MINIMAL_SVG_PREFIX = SVG_ROOT_OPEN .. "<defs>" .. FALLBACK_PLAYER_DEFINITION ..
    "</defs><rect width=\"320\" height=\"480\" fill=\"#07101f\"/>" ..
    "<text x=\"160\" y=\"24\" fill=\"#46e6e1\" font-family=\"monospace\" font-size=\"12\" text-anchor=\"middle\">MINIMAL RENDER</text>" ..
    "<use href=\"#fallback_player\" x=\""
  local MINIMAL_SVG_SUFFIX = "\" y=\"220\"/></svg>"

  local function AppendBackground(parts, state)
    local definitionId = "fallback_starfield"
    if AssetAvailable("background_tile") then
      definitionId = "background_tile"
    end

    local offset = state.backgroundOffset
    AppendTranslatedUse(parts, definitionId, 0, offset - GAME_CONFIG.LogicalHeight)
    AppendTranslatedUse(parts, definitionId, 0, offset)
  end

  local function AppendEnemy(parts, enemy)
    AppendSpriteUse(parts, "enemy_01", "fallback_enemy", enemy.x, enemy.y)
  end

  local function AppendPlayerBullet(parts, bullet)
    AppendSpriteUse(parts, "bullet_player", "fallback_player_bullet", bullet.x, bullet.y)
  end

  local function AppendEnemyBullet(parts, bullet)
    AppendSpriteUse(parts, "bullet_enemy", "fallback_enemy_bullet", bullet.x, bullet.y)
  end

  local function AppendPlayer(parts, player)
    AppendDefinitionUse(parts, ResolvePlayerDefinition(player.direction), player.x, player.y)
  end

  local function AppendExplosion(parts, explosion)
    local assetId = "explosion_0" .. tostring(explosion.frame)
    AppendSpriteUse(parts, assetId, "fallback_explosion", explosion.x, explosion.y)
  end

  local function BuildGameSvg(state)
    local parts = { GAME_SVG_PREFIX }

    AppendBackground(parts, state)

    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      if enemy.active then
        AppendEnemy(parts, enemy)
      end
    end

    for index = 1, #state.enemyBullets do
      local bullet = state.enemyBullets[index]
      if bullet.active then
        AppendEnemyBullet(parts, bullet)
      end
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      if bullet.active then
        AppendPlayerBullet(parts, bullet)
      end
    end

    AppendPlayer(parts, state.player)

    for index = 1, GAME_CONFIG.MaxExplosions do
      local explosion = state.explosions[index]
      if explosion.active then
        AppendExplosion(parts, explosion)
      end
    end

    parts[#parts + 1] = "<rect x=\"0\" y=\"0\" width=\"320\" height=\"30\" fill=\"#07101f\"/>"
    parts[#parts + 1] = "<text x=\"8\" y=\"20\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"12\">SCORE " ..
      tostring(state.score) .. "</text>"
    parts[#parts + 1] = "<text x=\"312\" y=\"20\" fill=\"#46e6e1\" font-family=\"monospace\" font-size=\"12\" text-anchor=\"end\">f5Rocket</text>"

    if state.paused then
      parts[#parts + 1] = "<rect x=\"78\" y=\"214\" width=\"164\" height=\"52\" fill=\"#07101f\" stroke=\"#ff9b45\"/>"
      parts[#parts + 1] = "<text x=\"160\" y=\"246\" fill=\"#ff9b45\" font-family=\"monospace\" font-size=\"18\" text-anchor=\"middle\">PAUSED</text>"
    elseif not state.running then
      parts[#parts + 1] = "<text x=\"160\" y=\"246\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"14\" text-anchor=\"middle\">PRESS START</text>"
    end

    parts[#parts + 1] = "</svg>"
    return table.concat(parts)
  end

  local function BuildTimerOnlySvg()
    return TIMER_ONLY_SVG
  end

  local function BuildMinimalDiagnosticSvg(motionX)
    return MINIMAL_SVG_PREFIX .. tostring(math.floor(motionX)) .. MINIMAL_SVG_SUFFIX
  end
  local rapidjson = require("rapidjson")

  local DIAGNOSTIC_MODE_CHOICES = { "TIMER ONLY", "MINIMAL RENDER", "FULL GAME" }
  local DIAGNOSTIC_MODE_VALUES = {
    ["TIMER ONLY"] = true,
    ["MINIMAL RENDER"] = true,
    ["FULL GAME"] = true
  }

  local gameState = CreateGameState()
  local activeDiagnosticMode = "FULL GAME"
  local measurementTicks = 0
  local measurementStartedAt = 0
  local timerTickCount = 0
  local lastRawBytes = 0
  local lastEncodedBytes = 0
  local lastTickStage = "IDLE"
  local minimalMotionX = 0
  local minimalMotionDirection = 1

  local MINIMAL_MOTION_MIN = 0
  local MINIMAL_MOTION_MAX = GAME_CONFIG.LogicalWidth - GAME_CONFIG.PlayerWidth
  local MINIMAL_MOTION_STEP = GAME_CONFIG.PlayerSpeed

  GameLegend = {
    DrawChrome = false,
    IconData = ""
  }

  -- Keep the single timer globally scoped so Q-SYS Lua GC cannot remove it.
  GameTimer = Timer.New()

  local function UpdateStatus(text)
    Controls.Status.String = text
  end

  local function SelectedDiagnosticMode()
    local selected = Controls.DiagnosticMode.String
    if DIAGNOSTIC_MODE_VALUES[selected] == nil then
      selected = "FULL GAME"
      Controls.DiagnosticMode.String = selected
    end
    return selected
  end

  local function RunningStatus()
    if activeDiagnosticMode == "FULL GAME" and gameState.paused then
      return "PAUSED / FULL GAME"
    end
    return "RUNNING / " .. activeDiagnosticMode
  end

  local function ResetMinimalMotion()
    minimalMotionX = MINIMAL_MOTION_MIN
    minimalMotionDirection = 1
  end

  local function UpdateMinimalMotion()
    minimalMotionX = minimalMotionX + minimalMotionDirection * MINIMAL_MOTION_STEP

    if minimalMotionX >= MINIMAL_MOTION_MAX then
      minimalMotionX = MINIMAL_MOTION_MAX
      minimalMotionDirection = -1
    elseif minimalMotionX <= MINIMAL_MOTION_MIN then
      minimalMotionX = MINIMAL_MOTION_MIN
      minimalMotionDirection = 1
    end
  end

  local function AssignSvgToViewportUnsafe(svg)
    lastTickStage = "BASE64"
    local encodedSvg = Crypto.Base64Encode(svg)
    lastRawBytes = #svg
    lastEncodedBytes = #encodedSvg

    lastTickStage = "LEGEND"
    GameLegend.IconData = encodedSvg
    Controls.Viewport.Legend = rapidjson.encode(GameLegend)
  end

  local function RenderSelectedFrameUnsafe()
    lastTickStage = "SVG"
    local svg
    if activeDiagnosticMode == "TIMER ONLY" then
      svg = BuildTimerOnlySvg()
    elseif activeDiagnosticMode == "MINIMAL RENDER" then
      svg = BuildMinimalDiagnosticSvg(minimalMotionX)
    else
      svg = BuildGameSvg(gameState)
    end
    AssignSvgToViewportUnsafe(svg)
  end

  local function UpdateTelemetryControlsUnsafe()
    lastTickStage = "TELEMETRY"
    Controls.SvgBytes.String = tostring(lastRawBytes)
    Controls.SvgBase64Bytes.String = tostring(lastEncodedBytes)

    if activeDiagnosticMode == "FULL GAME" then
      Controls.ActiveEnemies.String = tostring(CountActiveEnemies(gameState))
      Controls.ActivePlayerBullets.String = tostring(CountActivePlayerBullets(gameState))
    else
      Controls.ActiveEnemies.String = "0"
      Controls.ActivePlayerBullets.String = "0"
    end
  end

  local function ResetMeasurement()
    measurementTicks = 0
    measurementStartedAt = Timer.Now()
    Controls.MeasuredHz.String = "MEASURING"
  end

  local function CompleteTickTelemetryUnsafe()
    timerTickCount = timerTickCount + 1
    measurementTicks = measurementTicks + 1

    local now = Timer.Now()
    local elapsed = now - measurementStartedAt
    if elapsed >= 1 then
      lastTickStage = "TELEMETRY"
      Controls.MeasuredHz.String = string.format("%.1f Hz", measurementTicks / elapsed)
      UpdateTelemetryControlsUnsafe()
      measurementTicks = 0
      measurementStartedAt = now
    end

    lastTickStage = "DONE"
  end

  local function HandleRuntimeError(errorMessage)
    GameTimer:Stop()
    gameState.running = false
    gameState.paused = false
    Controls.Pause.Boolean = false

    local message = "ERROR @ " .. tostring(lastTickStage) .. ": " .. tostring(errorMessage)
    UpdateStatus(message)
    print("[f5Rocket] Tick error @ " .. tostring(lastTickStage) .. ": " .. tostring(errorMessage))
  end

  local function RenderImmediateProtected()
    local success, errorMessage = pcall(function()
      RenderSelectedFrameUnsafe()
      UpdateTelemetryControlsUnsafe()
      lastTickStage = "DONE"
    end)

    if not success then
      HandleRuntimeError(errorMessage)
      return false
    end
    return true
  end

  local function UpdateFullGameStateUnsafe()
    lastTickStage = "INPUT"
    local leftPressed = Controls.Left.Boolean
    local rightPressed = Controls.Right.Boolean
    local upPressed = Controls.Up.Boolean
    local downPressed = Controls.Down.Boolean
    local firePressed = Controls.Fire.Boolean

    if not gameState.running or gameState.paused then
      return
    end

    lastTickStage = "PLAYER"
    UpdatePlayer(
      gameState,
      leftPressed,
      rightPressed,
      upPressed,
      downPressed
    )
    if firePressed then
      FirePlayerBullet(gameState)
    end

    lastTickStage = "BULLETS"
    UpdatePlayerBullets(gameState)

    lastTickStage = "ENEMIES"
    UpdateEnemies(gameState)

    lastTickStage = "COLLISION"
    CheckPlayerBulletEnemyCollisions(gameState)

    lastTickStage = "BACKGROUND"
    gameState.backgroundOffset = (
      gameState.backgroundOffset + GAME_CONFIG.BackgroundScrollPerTick
    ) % GAME_CONFIG.LogicalHeight
    gameState.ticks = gameState.ticks + 1
    gameState.time = gameState.ticks * GAME_CONFIG.UpdateInterval
  end

  local function GameTickUnsafe()
    if activeDiagnosticMode == "TIMER ONLY" then
      lastTickStage = "INPUT"
      -- Deliberately no game update and no per-tick Viewport.Legend assignment.
    elseif activeDiagnosticMode == "MINIMAL RENDER" then
      lastTickStage = "PLAYER"
      UpdateMinimalMotion()
      RenderSelectedFrameUnsafe()
    else
      UpdateFullGameStateUnsafe()
      RenderSelectedFrameUnsafe()
    end

    CompleteTickTelemetryUnsafe()
  end

  local function StartGame()
    GameTimer:Stop()
    ResetGameState(gameState)
    ResetEnemies(gameState)
    ResetMinimalMotion()
    timerTickCount = 0
    gameState.running = true
    gameState.paused = false
    Controls.Pause.Boolean = false
    activeDiagnosticMode = SelectedDiagnosticMode()
    ResetMeasurement()

    if RenderImmediateProtected() then
      UpdateStatus(RunningStatus())
      GameTimer:Start(GAME_CONFIG.UpdateInterval)
    end
  end

  local function ApplyDiagnosticModeChange()
    local wasRunning = gameState.running
    GameTimer:Stop()
    activeDiagnosticMode = SelectedDiagnosticMode()
    gameState.paused = false
    Controls.Pause.Boolean = false
    ResetMinimalMotion()
    timerTickCount = 0
    ResetMeasurement()

    if RenderImmediateProtected() then
      if wasRunning then
        UpdateStatus(RunningStatus())
        GameTimer:Start(GAME_CONFIG.UpdateInterval)
      else
        Controls.MeasuredHz.String = "0.0 Hz"
        UpdateStatus("READY / " .. activeDiagnosticMode)
      end
    end
  end

  GameTimer.EventHandler = function()
    local success, errorMessage = pcall(GameTickUnsafe)
    if not success then
      HandleRuntimeError(errorMessage)
    end
  end

  Controls.Start.EventHandler = function(control)
    if control.Boolean then
      StartGame()
    end
  end

  Controls.Pause.EventHandler = function(control)
    if not gameState.running or activeDiagnosticMode ~= "FULL GAME" then
      control.Boolean = false
      return
    end

    gameState.paused = control.Boolean
    UpdateStatus(RunningStatus())
    RenderImmediateProtected()
  end

  Controls.DiagnosticMode.EventHandler = function()
    ApplyDiagnosticModeChange()
  end

  Controls.DiagnosticMode.Choices = DIAGNOSTIC_MODE_CHOICES
  activeDiagnosticMode = SelectedDiagnosticMode()
  ResetGameState(gameState)
  ResetEnemies(gameState)
  ResetMinimalMotion()
  Controls.Pause.Boolean = false
  Controls.MeasuredHz.String = "0.0 Hz"
  UpdateStatus("READY / " .. AssetAvailabilitySummary())

  local missingAssets = MissingAssetList()
  if missingAssets ~= "" then
    print("[f5Rocket] Missing PNG assets; definition-based SVG fallbacks active: " .. missingAssets)
  end

  RenderImmediateProtected()
end
