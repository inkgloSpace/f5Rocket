  -- Hostile shots use SVG geometry so their silhouette and hot core remain
  -- readable on every stage without embedding a separate PNG.
  local ENEMY_BULLET_VISIBLE_DEFINITION =
    "<g id=\"enemy_bullet_visible\">" ..
    "<rect x=\"0\" y=\"0\" width=\"6\" height=\"14\" rx=\"2\" fill=\"#160811\"/>" ..
    "<rect x=\"1\" y=\"1\" width=\"4\" height=\"12\" rx=\"2\" fill=\"#ff315f\"/>" ..
    "<rect x=\"2\" y=\"2\" width=\"2\" height=\"9\" fill=\"#ffffff\"/>" ..
    "</g>"

  local FALLBACK_EXPLOSION_DEFINITION =
    "<g id=\"fallback_explosion\"><path d=\"M22 0L27 15L44 22L27 29L22 44L17 29L0 22L17 15Z\" fill=\"#ff9b45\"/></g>"

  local FALLBACK_BOSS_EASY_DEFINITION =
    "<g id=\"fallback_boss_easy\"><rect width=\"72\" height=\"56\" fill=\"#42d9ff\"/>" ..
    "<rect x=\"12\" y=\"12\" width=\"48\" height=\"32\" fill=\"#135f8a\"/></g>"

  local FALLBACK_BOSS_MEDIUM_DEFINITION =
    "<g id=\"fallback_boss_medium\"><rect width=\"88\" height=\"64\" fill=\"#ba65ff\"/>" ..
    "<rect x=\"14\" y=\"14\" width=\"60\" height=\"36\" fill=\"#572080\"/></g>"

  local FALLBACK_BOSS_FINAL_DEFINITION =
    "<g id=\"fallback_boss_final\"><rect width=\"120\" height=\"80\" fill=\"#ff3d9b\"/>" ..
    "<rect x=\"18\" y=\"16\" width=\"84\" height=\"48\" fill=\"#4a1038\"/></g>"

  local ASSETS = {}
  local DYNAMIC_DEFINITION_PARTS = {}
  local RUNTIME_DEFINITION_AVAILABLE = {}
  local MISSING_ASSET_PATHS = {}
  local availableAssetCount = 0

  for index = 1, #ASSET_MANIFEST do
    local metadata = ASSET_MANIFEST[index]
    local generated = GENERATED_ASSET_DATA[metadata.Id]
    local available = generated ~= nil and generated.Available and generated.DataUri ~= ""

    ASSETS[metadata.Id] = {
      Id = metadata.Id,
      Source = metadata.Source,
      Width = metadata.Width,
      Height = metadata.Height,
      Available = available,
      DataUri = available and generated.DataUri or "",
      SourceBytes = available and generated.SourceBytes or 0,
      EncodedBytes = available and generated.EncodedBytes or 0
    }

    if available then
      availableAssetCount = availableAssetCount + 1
      if DYNAMIC_GAMEPLAY_ASSETS[metadata.Id] then
        DYNAMIC_DEFINITION_PARTS[#DYNAMIC_DEFINITION_PARTS + 1] =
          "<image id=\"" .. metadata.Id .. "\" href=\"" .. generated.DataUri ..
          "\" width=\"" .. tostring(metadata.Width) .. "\" height=\"" ..
          tostring(metadata.Height) .. "\" preserveAspectRatio=\"none\"/>"
        RUNTIME_DEFINITION_AVAILABLE[metadata.Id] = true
      end
    else
      MISSING_ASSET_PATHS[#MISSING_ASSET_PATHS + 1] = metadata.Source
    end
  end

  local function RuntimeSourceId(assetId, fallbackId)
    if RUNTIME_DEFINITION_AVAILABLE[assetId] then
      return assetId
    end
    return fallbackId
  end

  local ENEMY_ORIENTATION_DEFINITIONS = table.concat({
    "<g id=\"enemy_easy_down\"><use href=\"#" .. RuntimeSourceId("enemy_easy", "fallback_enemy") ..
      "\" transform=\"rotate(180 17 17)\"/></g>",
    "<g id=\"enemy_medium_down\"><use href=\"#" .. RuntimeSourceId("enemy_medium", "fallback_enemy") ..
      "\" transform=\"rotate(180 17 17)\"/></g>",
    "<g id=\"enemy_hard_down\"><use href=\"#" .. RuntimeSourceId("enemy_hard", "fallback_enemy") ..
      "\" transform=\"rotate(180 17 17)\"/></g>"
  })

  local BOSS_ORIENTATION_DEFINITIONS = table.concat({
    "<g id=\"boss_mini_easy_down\"><use href=\"#" ..
      RuntimeSourceId("mini_boss_easy", "fallback_boss_easy") ..
      "\" transform=\"rotate(180 36 28)\"/></g>",
    "<g id=\"boss_mini_medium_down\"><use href=\"#" ..
      RuntimeSourceId("mini_boss_medium", "fallback_boss_medium") ..
      "\" transform=\"rotate(180 44 32)\"/></g>",
    "<g id=\"boss_final_down\"><use href=\"#" ..
      RuntimeSourceId("final_boss", "fallback_boss_final") ..
      "\" transform=\"rotate(180 60 40)\"/></g>"
  })

  local DYNAMIC_GAMEPLAY_DEFINITIONS = table.concat(DYNAMIC_DEFINITION_PARTS) ..
    FALLBACK_PLAYER_DEFINITION .. FALLBACK_ENEMY_DEFINITION ..
    PLAYER_BULLET_VISIBLE_DEFINITION .. ENEMY_BULLET_VISIBLE_DEFINITION ..
    FALLBACK_EXPLOSION_DEFINITION .. FALLBACK_BOSS_EASY_DEFINITION ..
    FALLBACK_BOSS_MEDIUM_DEFINITION .. FALLBACK_BOSS_FINAL_DEFINITION ..
    ENEMY_ORIENTATION_DEFINITIONS .. BOSS_ORIENTATION_DEFINITIONS

  local function AssetAvailable(assetId)
    local asset = ASSETS[assetId]
    return asset ~= nil and asset.Available
  end

  local function RuntimeDefinitionAvailable(assetId)
    return RUNTIME_DEFINITION_AVAILABLE[assetId] == true
  end

  local function AppendDefinitionUse(parts, definitionId, x, y)
    parts[#parts + 1] = "<use href=\"#" .. definitionId .. "\" x=\"" ..
      tostring(math.floor(x)) .. "\" y=\"" .. tostring(math.floor(y)) .. "\"/>"
  end

  local function AppendSpriteUse(parts, assetId, fallbackId, x, y)
    AppendDefinitionUse(parts, RuntimeSourceId(assetId, fallbackId), x, y)
  end

  local function ResolvePlayerDefinition(direction)
    if direction == "left" and RuntimeDefinitionAvailable("player_left") then
      return "player_left"
    end
    if direction == "right" and RuntimeDefinitionAvailable("player_right") then
      return "player_right"
    end
    return RuntimeSourceId("player_idle", "fallback_player")
  end

  local function ResolveBossDefinition(bossType)
    if bossType == "MINI_EASY" then
      return "boss_mini_easy_down"
    elseif bossType == "MINI_MEDIUM" then
      return "boss_mini_medium_down"
    end
    return "boss_final_down"
  end

  local function AssetAvailabilitySummary()
    return tostring(availableAssetCount) .. "/" .. tostring(#ASSET_MANIFEST) .. " ASSETS"
  end

  local function DynamicGameplayDefinitionBytes()
    return #DYNAMIC_GAMEPLAY_DEFINITIONS
  end

  local function MissingAssetList()
    return table.concat(MISSING_ASSET_PATHS, ", ")
  end
  local function CreateGameState()
    local state = {
      running = false,
      paused = false,
      gameOver = false,
      gameOverTicks = 0,
      gameOverFrozen = false,
      gameClear = false,
      campaignFrozen = false,
      stageIndex = 1,
      stageName = "EASY",
      stageScore = 0,
      stagePhase = "WAVE",
      stageTransitionTicks = 0,
      score = 0,
      time = 0,
      ticks = 0,
      backgroundScrollY = 0,
      player = {},
      boss = {
        active = false,
        bossType = "",
        assetId = "",
        label = "",
        x = 0,
        y = 0,
        width = 0,
        height = 0,
        hp = 0,
        maxHp = 0,
        direction = 1,
        fireCooldown = 0,
        patternTick = 0,
        volleyCount = 0,
        entered = false
      },
      enemies = {},
      playerBullets = {},
      enemyBullets = {},
      explosions = {},
      parallax = {
        far = {},
        mid = {},
        near = {}
      }
    }

    for index = 1, GAME_CONFIG.MaxEnemies do
      state.enemies[index] = {
        active = false,
        x = 0,
        y = 0,
        width = GAME_CONFIG.EnemyWidth,
        height = GAME_CONFIG.EnemyHeight,
        slot = index,
        cycle = 0,
        fireCooldown = 0
      }
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      state.playerBullets[index] = {
        active = false,
        x = 0,
        y = 0,
        width = GAME_CONFIG.PlayerBulletWidth,
        height = GAME_CONFIG.PlayerBulletHeight
      }
    end

    for index = 1, GAME_CONFIG.MaxEnemyBullets do
      state.enemyBullets[index] = {
        active = false,
        x = 0,
        y = 0,
        vx = 0,
        vy = 0,
        width = GAME_CONFIG.EnemyBulletWidth,
        height = GAME_CONFIG.EnemyBulletHeight
      }
    end

    for index = 1, GAME_CONFIG.MaxExplosions do
      state.explosions[index] = {
        active = false,
        x = 0,
        y = 0,
        frame = 1,
        frameTicksRemaining = 0,
        delayTicks = 0
      }
    end

    for index = 1, GAME_CONFIG.MaxFarParallax do
      state.parallax.far[index] = {
        active = false,
        x = 0,
        y = 0,
        speed = 0,
        variant = 1,
        slot = index,
        cycle = 0,
        driftX = 0
      }
    end

    for index = 1, GAME_CONFIG.MaxMidParallax do
      state.parallax.mid[index] = {
        active = false,
        x = 0,
        y = 0,
        speed = 0,
        variant = 1,
        slot = index,
        cycle = 0,
        driftX = 0
      }
    end

    for index = 1, GAME_CONFIG.MaxNearParallax do
      state.parallax.near[index] = {
        active = false,
        x = 0,
        y = 0,
        speed = 0,
        variant = 1,
        slot = index,
        cycle = 0,
        driftX = 0
      }
    end

    return state
  end

  local function ResetGameState(state)
    state.running = false
    state.paused = false
    state.gameOver = false
    state.gameOverTicks = 0
    state.gameOverFrozen = false
    state.gameClear = false
    state.campaignFrozen = false
    state.stageIndex = 1
    state.stageName = "EASY"
    state.stageScore = 0
    state.stagePhase = "WAVE"
    state.stageTransitionTicks = 0
    state.score = 0
    state.time = 0
    state.ticks = 0
    state.backgroundScrollY = 0

    state.player.x = math.floor((GAME_CONFIG.LogicalWidth - GAME_CONFIG.PlayerWidth) / 2)
    state.player.y = GAME_CONFIG.PlayerStartY
    state.player.width = GAME_CONFIG.PlayerWidth
    state.player.height = GAME_CONFIG.PlayerHeight
    state.player.direction = "idle"
    state.player.fireCooldown = 0
    state.player.burstShots = 0
    state.player.burstCooldown = 0
    state.player.burstIdleTicks = 0
    state.player.alive = true

    local boss = state.boss
    boss.active = false
    boss.bossType = ""
    boss.assetId = ""
    boss.label = ""
    boss.x = 0
    boss.y = 0
    boss.width = 0
    boss.height = 0
    boss.hp = 0
    boss.maxHp = 0
    boss.direction = 1
    boss.fireCooldown = 0
    boss.patternTick = 0
    boss.volleyCount = 0
    boss.entered = false

    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      enemy.active = false
      enemy.x = 0
      enemy.y = 0
      enemy.cycle = 0
      enemy.fireCooldown = 0
    end

    for index = 1, GAME_CONFIG.MaxEnemyBullets do
      local bullet = state.enemyBullets[index]
      bullet.active = false
      bullet.x = 0
      bullet.y = 0
      bullet.vx = 0
      bullet.vy = 0
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      bullet.active = false
      bullet.x = 0
      bullet.y = 0
    end

    for index = 1, GAME_CONFIG.MaxExplosions do
      local explosion = state.explosions[index]
      explosion.active = false
      explosion.x = 0
      explosion.y = 0
      explosion.frame = 1
      explosion.frameTicksRemaining = 0
      explosion.delayTicks = 0
    end


    local function ResetParallaxPool(pool, maximum)
      for index = 1, maximum do
        local item = pool[index]
        item.active = false
        item.x = 0
        item.y = 0
        item.speed = 0
        item.variant = 1
        item.cycle = 0
        item.driftX = 0
      end
    end

    ResetParallaxPool(state.parallax.far, GAME_CONFIG.MaxFarParallax)
    ResetParallaxPool(state.parallax.mid, GAME_CONFIG.MaxMidParallax)
    ResetParallaxPool(state.parallax.near, GAME_CONFIG.MaxNearParallax)
  end
  local function ClampInteger(value, minimum, maximum)
    if value < minimum then
      return minimum
    end
    if value > maximum then
      return maximum
    end
    return math.floor(value)
  end

  local function UpdatePlayer(state, leftPressed, rightPressed, upPressed, downPressed)
    local player = state.player
    if not player.alive then
      return
    end

    local horizontal = 0
    local vertical = 0

    if leftPressed then
      horizontal = horizontal - 1
    end
    if rightPressed then
      horizontal = horizontal + 1
    end
    if upPressed then
      vertical = vertical - 1
    end
    if downPressed then
      vertical = vertical + 1
    end

    local movement = GAME_CONFIG.PlayerSpeed
    if horizontal ~= 0 and vertical ~= 0 then
      movement = GAME_CONFIG.PlayerDiagonalSpeed
    end

    player.x = ClampInteger(
      player.x + horizontal * movement,
      0,
      GAME_CONFIG.LogicalWidth - player.width
    )
    player.y = ClampInteger(
      player.y + vertical * movement,
      0,
      GAME_CONFIG.LogicalHeight - player.height
    )

    if horizontal < 0 then
      player.direction = "left"
    elseif horizontal > 0 then
      player.direction = "right"
    else
      player.direction = "idle"
    end

    if player.fireCooldown > 0 then
      player.fireCooldown = player.fireCooldown - 1
    end
  end
  local function UpdatePlayerBurstState(state)
    local player = state.player
    if not player.alive then
      return
    end

    if player.burstCooldown > 0 then
      player.burstCooldown = player.burstCooldown - 1
      return
    end

    if player.burstShots > 0 then
      player.burstIdleTicks = player.burstIdleTicks + 1
      if player.burstIdleTicks >= GAME_CONFIG.BurstResetTicks then
        player.burstShots = 0
        player.burstIdleTicks = 0
      end
    end
  end

  local function FirePlayerBullet(state)
    local player = state.player
    if not player.alive or
        player.fireCooldown > 0 or
        player.burstCooldown > 0 then
      return false
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      if not bullet.active then
        bullet.active = true
        bullet.x = math.floor(player.x + (player.width - bullet.width) / 2)
        bullet.y = player.y - bullet.height
        player.fireCooldown = GAME_CONFIG.FireIntervalTicks
        player.burstShots = player.burstShots + 1
        player.burstIdleTicks = 0

        if player.burstShots >= GAME_CONFIG.MaxBurstShots then
          player.burstCooldown = GAME_CONFIG.BurstCooldownTicks
          player.burstShots = 0
          player.burstIdleTicks = 0
        end

        return true
      end
    end

    return false
  end

  local function FireEnemyVectorBullet(state, startX, startY, vx, vy)
    if not state.player.alive then
      return false
    end

    for index = 1, GAME_CONFIG.MaxEnemyBullets do
      local bullet = state.enemyBullets[index]
      if not bullet.active then
        bullet.active = true
        bullet.x = math.floor(startX - bullet.width / 2)
        bullet.y = math.floor(startY)
        bullet.vx = vx
        bullet.vy = vy
        return true
      end
    end

    return false
  end

  local function FireEnemyAimedBullet(state, source, bulletSpeed)
    local startX = source.x + source.width / 2
    local startY = source.y + source.height
    local targetX = state.player.x + state.player.width / 2
    local targetY = state.player.y + state.player.height / 2
    local dx = targetX - startX
    local dy = targetY - startY
    local distance = math.sqrt(dx * dx + dy * dy)

    if distance < 0.0001 then
      dx = 0
      dy = 1
      distance = 1
    end

    return FireEnemyVectorBullet(
      state,
      startX,
      startY,
      dx / distance * bulletSpeed,
      dy / distance * bulletSpeed
    )
  end

  local function UpdatePlayerBullets(state)
    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      if bullet.active then
        bullet.y = bullet.y - GAME_CONFIG.PlayerBulletSpeed
        if bullet.y + bullet.height < 0 then
          bullet.active = false
        end
      end
    end
  end

  local function UpdateEnemyBullets(state)
    for index = 1, GAME_CONFIG.MaxEnemyBullets do
      local bullet = state.enemyBullets[index]
      if bullet.active then
        bullet.x = bullet.x + bullet.vx
        bullet.y = bullet.y + bullet.vy

        if bullet.x < -bullet.width or
            bullet.x > GAME_CONFIG.LogicalWidth or
            bullet.y < -bullet.height or
            bullet.y > GAME_CONFIG.LogicalHeight then
          bullet.active = false
        end
      end
    end
  end

  local function CountActiveEnemyBullets(state)
    local count = 0
    for index = 1, GAME_CONFIG.MaxEnemyBullets do
      if state.enemyBullets[index].active then
        count = count + 1
      end
    end
    return count
  end

  local function CountActivePlayerBullets(state)
    local count = 0
    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      if state.playerBullets[index].active then
        count = count + 1
      end
    end
    return count
  end
  local function GetStageProfile(stateOrIndex)
    local index = stateOrIndex
    if type(stateOrIndex) == "table" then
      index = stateOrIndex.stageIndex
    end
    return STAGE_PROFILES[index]
  end

  local function UpdateBackgroundScroll(state)
    local profile = GetStageProfile(state)
    local nextY = state.backgroundScrollY + profile.BackgroundScrollSpeed
    if nextY >= GAME_CONFIG.BackgroundTileHeight then
      nextY = nextY - GAME_CONFIG.BackgroundTileHeight
    end
    state.backgroundScrollY = nextY
  end

  local function DeactivateOrdinaryEnemies(state)
    for index = 1, GAME_CONFIG.MaxEnemies do
      state.enemies[index].active = false
    end
  end

  local function DeactivateEnemyBullets(state)
    for index = 1, GAME_CONFIG.MaxEnemyBullets do
      state.enemyBullets[index].active = false
    end
  end

  local function DeactivatePlayerBullets(state)
    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      state.playerBullets[index].active = false
    end
  end

  local function EnterStage(state, stageIndex)
    local profile = STAGE_PROFILES[stageIndex]
    state.stageIndex = stageIndex
    state.stageName = profile.Name
    state.stageScore = 0
    state.stagePhase = "WAVE"
    state.stageTransitionTicks = 0
    state.backgroundScrollY = 0
    state.gameClear = false
    state.campaignFrozen = false
    state.boss.active = false
    DeactivatePlayerBullets(state)
    DeactivateEnemyBullets(state)
  end

  local function StageThresholdReached(state)
    local profile = GetStageProfile(state)
    return state.stagePhase == "WAVE" and
      state.stageScore >= profile.ScoreThreshold
  end

  local function BeginBossPhase(state)
    state.stagePhase = "BOSS"
    DeactivateOrdinaryEnemies(state)
    DeactivateEnemyBullets(state)
  end

  local function BeginStageClear(state)
    state.stagePhase = "CLEAR"
    state.stageTransitionTicks = GAME_CONFIG.StageClearTicks
    DeactivateOrdinaryEnemies(state)
    DeactivateEnemyBullets(state)
    if state.stageIndex == 3 then
      state.gameClear = true
    end
  end

  -- Returns the next stage index exactly once when a miniboss clear delay ends.
  local function AdvanceStageClear(state)
    if state.campaignFrozen then
      return nil
    end

    if state.stageTransitionTicks > 0 then
      state.stageTransitionTicks = state.stageTransitionTicks - 1
    end

    if state.stageTransitionTicks > 0 then
      return nil
    end

    if state.stageIndex < 3 then
      local nextStage = state.stageIndex + 1
      EnterStage(state, nextStage)
      return nextStage
    end

    state.campaignFrozen = true
    return nil
  end
  local PARALLAX_LAYER_FAR = 1
  local PARALLAX_LAYER_MID = 2
  local PARALLAX_LAYER_NEAR = 3

  local function ParallaxLayerSettings(profile, layer)
    if layer == PARALLAX_LAYER_FAR then
      return profile.FarCount, profile.FarSpeedMin, profile.FarSpeedMax, 4
    elseif layer == PARALLAX_LAYER_MID then
      return profile.MidCount, profile.MidSpeedMin, profile.MidSpeedMax, 16
    end
    return profile.NearCount, profile.NearSpeedMin, profile.NearSpeedMax, 24
  end

  local function ConfigureParallaxItem(item, stageIndex, layer, initialPosition)
    local profile = PARALLAX_PROFILES[stageIndex]
    local _, minimumSpeed, maximumSpeed, margin =
      ParallaxLayerSettings(profile, layer)
    local layerSeed = layer * 23
    local speedStep = (
      item.slot * 7 + item.cycle * 5 + stageIndex * 3 + layerSeed
    ) % 7

    item.x = (
      item.slot * 47 + item.cycle * 31 + stageIndex * 19 + layerSeed
    ) % GAME_CONFIG.LogicalWidth

    if initialPosition then
      item.y = (
        item.slot * (61 + layerSeed) + stageIndex * 41
      ) % GAME_CONFIG.LogicalHeight
    else
      item.y = -margin - (
        item.slot * 17 + item.cycle * 13 + stageIndex * 11
      ) % 96
    end

    item.speed = minimumSpeed +
      (maximumSpeed - minimumSpeed) * speedStep / 6
    item.variant = 1 + (
      item.slot + item.cycle + stageIndex + layer
    ) % 2

    if layer == PARALLAX_LAYER_FAR then
      item.driftX = 0
    else
      item.driftX = (
        (item.slot + item.cycle + stageIndex) % 3 - 1
      ) * 0.25
    end

    -- Keep the flight lane comparatively clean while allowing sparse edge
    -- streaks to provide the strongest foreground speed cue.
    if layer == PARALLAX_LAYER_NEAR and item.x > 112 and item.x < 208 then
      item.x = (item.x + 128) % GAME_CONFIG.LogicalWidth
    end
  end

  local function ResetParallaxLayer(pool, maximum, activeCount, stageIndex, layer)
    for index = 1, maximum do
      local item = pool[index]
      item.active = index <= activeCount
      item.cycle = 0
      if item.active then
        ConfigureParallaxItem(item, stageIndex, layer, true)
      end
    end
  end

  local function ResetParallax(state, stageIndex)
    local profile = PARALLAX_PROFILES[stageIndex]
    ResetParallaxLayer(
      state.parallax.far,
      GAME_CONFIG.MaxFarParallax,
      profile.FarCount,
      stageIndex,
      PARALLAX_LAYER_FAR
    )
    ResetParallaxLayer(
      state.parallax.mid,
      GAME_CONFIG.MaxMidParallax,
      profile.MidCount,
      stageIndex,
      PARALLAX_LAYER_MID
    )
    ResetParallaxLayer(
      state.parallax.near,
      GAME_CONFIG.MaxNearParallax,
      profile.NearCount,
      stageIndex,
      PARALLAX_LAYER_NEAR
    )
  end

  local function ParallaxSpeedMultiplier(state)
    if state.gameOver then
      return GAME_CONFIG.GameOverParallaxMultiplier
    elseif state.gameClear then
      return GAME_CONFIG.GameClearParallaxMultiplier
    elseif state.stagePhase == "CLEAR" then
      return GAME_CONFIG.StageClearParallaxMultiplier
    elseif state.stagePhase == "BOSS" then
      return GAME_CONFIG.BossParallaxMultiplier
    end
    return 1
  end

  local function UpdateParallaxLayer(
      pool,
      maximum,
      state,
      layer,
      multiplier
    )
    local _, _, _, margin =
      ParallaxLayerSettings(PARALLAX_PROFILES[state.stageIndex], layer)

    for index = 1, maximum do
      local item = pool[index]
      if item.active then
        item.x = item.x + item.driftX * multiplier
        item.y = item.y + item.speed * multiplier

        if item.x < -margin then
          item.x = GAME_CONFIG.LogicalWidth + margin
        elseif item.x > GAME_CONFIG.LogicalWidth + margin then
          item.x = -margin
        end

        if item.y > GAME_CONFIG.LogicalHeight + margin then
          item.cycle = item.cycle + 1
          ConfigureParallaxItem(
            item,
            state.stageIndex,
            layer,
            false
          )
        end
      end
    end
  end

  local function UpdateParallax(state)
    local multiplier = ParallaxSpeedMultiplier(state)
    UpdateParallaxLayer(
      state.parallax.far,
      GAME_CONFIG.MaxFarParallax,
      state,
      PARALLAX_LAYER_FAR,
      multiplier
    )
    UpdateParallaxLayer(
      state.parallax.mid,
      GAME_CONFIG.MaxMidParallax,
      state,
      PARALLAX_LAYER_MID,
      multiplier
    )
    UpdateParallaxLayer(
      state.parallax.near,
      GAME_CONFIG.MaxNearParallax,
      state,
      PARALLAX_LAYER_NEAR,
      multiplier
    )
  end
  local function EnemyFireDelay(enemy, initialSpawn, profile)
    if initialSpawn then
      return math.floor(profile.EnemyFireIntervalTicks / 3) +
        (enemy.slot - 1) * 12
    end

    local stagger = (
      enemy.slot * 7 + enemy.cycle * 11
    ) % GAME_CONFIG.EnemyFireStaggerTicks
    return profile.EnemyFireIntervalTicks + stagger
  end

  local function RecycleEnemy(state, enemy)
    local profile = GetStageProfile(state)
    enemy.cycle = enemy.cycle + 1
    local horizontalRange = GAME_CONFIG.LogicalWidth - enemy.width
    enemy.x = (enemy.slot * 53 + enemy.cycle * 29) % horizontalRange
    enemy.y = -enemy.height - ((enemy.slot * 37 + enemy.cycle * 11) % 160)
    enemy.fireCooldown = EnemyFireDelay(enemy, false, profile)
    enemy.active = true
  end

  local function ResetEnemies(state)
    local profile = GetStageProfile(state)
    local horizontalRange = GAME_CONFIG.LogicalWidth - GAME_CONFIG.EnemyWidth

    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      enemy.active = index <= profile.EnemyCount
      enemy.cycle = 0
      enemy.x = ((index - 1) * 73 + 20) % horizontalRange
      enemy.y = 48 - (index - 1) * 96
      enemy.fireCooldown = EnemyFireDelay(enemy, true, profile)
    end
  end

  local function UpdateEnemies(state)
    local profile = GetStageProfile(state)
    local playerCenterX = state.player.x + state.player.width / 2
    local maximumX = GAME_CONFIG.LogicalWidth - GAME_CONFIG.EnemyWidth

    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      if enemy.active then
        local enemyCenterX = enemy.x + enemy.width / 2
        local deltaX = playerCenterX - enemyCenterX

        if deltaX > 0 then
          enemy.x = enemy.x + math.min(deltaX, profile.EnemySteerSpeed)
        elseif deltaX < 0 then
          enemy.x = enemy.x - math.min(-deltaX, profile.EnemySteerSpeed)
        end

        enemy.x = math.max(0, math.min(maximumX, enemy.x))
        enemy.y = enemy.y + profile.EnemyVerticalSpeed

        if enemy.y > GAME_CONFIG.LogicalHeight then
          RecycleEnemy(state, enemy)
        end
      end
    end
  end

  local function UpdateEnemyFire(state)
    if not state.player.alive then
      return
    end

    local profile = GetStageProfile(state)
    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      if enemy.active then
        if enemy.fireCooldown > 0 then
          enemy.fireCooldown = enemy.fireCooldown - 1
        end

        if enemy.fireCooldown <= 0 and
            enemy.y > 20 and
            enemy.y < state.player.y - GAME_CONFIG.EnemyFireSafetyDistance then
          if FireEnemyAimedBullet(state, enemy, profile.EnemyBulletSpeed) then
            enemy.fireCooldown = EnemyFireDelay(enemy, false, profile)
          else
            enemy.fireCooldown = GAME_CONFIG.EnemyFireRetryTicks
          end
        end
      end
    end
  end

  local function CountActiveEnemies(state)
    local count = 0
    for index = 1, GAME_CONFIG.MaxEnemies do
      if state.enemies[index].active then
        count = count + 1
      end
    end
    return count
  end
  local function ScheduleExplosion(state, x, y, delayTicks)
    for index = 1, GAME_CONFIG.MaxExplosions do
      local explosion = state.explosions[index]
      if not explosion.active then
        explosion.active = true
        explosion.x = math.floor(x)
        explosion.y = math.floor(y)
        explosion.frame = 1
        explosion.frameTicksRemaining = GAME_CONFIG.ExplosionFrameTicks
        explosion.delayTicks = delayTicks or 0
        return true
      end
    end

    return false
  end


  local function SpawnExplosion(state, x, y)
    return ScheduleExplosion(state, x, y, 0)
  end

  local function UpdateExplosions(state)
    for index = 1, GAME_CONFIG.MaxExplosions do
      local explosion = state.explosions[index]
      if explosion.active then
        if explosion.delayTicks > 0 then
          explosion.delayTicks = explosion.delayTicks - 1
        else
          explosion.frameTicksRemaining = explosion.frameTicksRemaining - 1

          if explosion.frameTicksRemaining <= 0 then
            explosion.frame = explosion.frame + 1
            if explosion.frame > GAME_CONFIG.ExplosionFrames then
              explosion.active = false
            else
              explosion.frameTicksRemaining = GAME_CONFIG.ExplosionFrameTicks
            end
          end
        end
      end
    end
  end

  local function AdvanceGameOverAnimation(state)
    if state.gameOverFrozen then
      return
    end

    UpdateExplosions(state)
    state.gameOverTicks = state.gameOverTicks + 1
    if state.gameOverTicks >= GAME_CONFIG.GameOverAnimationTicks then
      state.gameOverFrozen = true
    end
  end

  local function CountActiveExplosions(state)
    local count = 0
    for index = 1, GAME_CONFIG.MaxExplosions do
      if state.explosions[index].active then
        count = count + 1
      end
    end
    return count
  end
  local function ResetBoss(state)
    local boss = state.boss
    boss.active = false
    boss.bossType = ""
    boss.assetId = ""
    boss.label = ""
    boss.x = 0
    boss.y = 0
    boss.width = 0
    boss.height = 0
    boss.hp = 0
    boss.maxHp = 0
    boss.direction = 1
    boss.fireCooldown = 0
    boss.patternTick = 0
    boss.volleyCount = 0
    boss.entered = false
  end

  local function SpawnBoss(state)
    local stageProfile = GetStageProfile(state)
    local profile = BOSS_PROFILES[stageProfile.BossType]
    local boss = state.boss

    boss.active = true
    boss.bossType = stageProfile.BossType
    boss.assetId = profile.Asset
    boss.label = profile.Label
    boss.width = profile.Width
    boss.height = profile.Height
    boss.x = math.floor((GAME_CONFIG.LogicalWidth - boss.width) / 2)
    boss.y = -boss.height
    boss.hp = profile.MaxHp
    boss.maxHp = profile.MaxHp
    boss.direction = 1
    boss.fireCooldown = profile.FireIntervalTicks
    boss.patternTick = 0
    boss.volleyCount = 0
    boss.entered = false
  end

  local function FireBossFan(state, boss, shotCount, bulletSpeed)
    local startX = boss.x + boss.width / 2
    local startY = boss.y + boss.height
    local centerIndex = (shotCount + 1) / 2

    for index = 1, shotCount do
      local angle = (index - centerIndex) * 0.24
      FireEnemyVectorBullet(
        state,
        startX,
        startY,
        math.sin(angle) * bulletSpeed,
        math.cos(angle) * bulletSpeed
      )
    end
  end

  local function FireBossPattern(state, boss, profile)
    boss.volleyCount = boss.volleyCount + 1

    if boss.bossType == "MINI_EASY" then
      FireEnemyAimedBullet(state, boss, profile.BulletSpeed)
    elseif boss.bossType == "MINI_MEDIUM" then
      FireBossFan(state, boss, 3, profile.BulletSpeed)
      if boss.volleyCount % 3 == 0 then
        FireEnemyAimedBullet(state, boss, profile.BulletSpeed)
      end
    else
      if boss.hp > boss.maxHp / 2 then
        FireBossFan(state, boss, 3, profile.BulletSpeed)
        if boss.volleyCount % 3 == 0 then
          FireEnemyAimedBullet(state, boss, profile.BulletSpeed)
        end
      else
        FireBossFan(state, boss, 5, profile.BulletSpeed)
        if boss.volleyCount % 2 == 0 then
          FireEnemyAimedBullet(state, boss, profile.BulletSpeed)
        end
      end
    end
  end

  local function UpdateBoss(state)
    local boss = state.boss
    if not boss.active then
      return
    end

    local profile = BOSS_PROFILES[boss.bossType]
    boss.patternTick = boss.patternTick + 1

    if not boss.entered then
      boss.y = boss.y + profile.EntrySpeed
      if boss.y >= profile.EntryY then
        boss.y = profile.EntryY
        boss.entered = true
      end
      return
    end

    local moveSpeed = profile.MoveSpeed
    if boss.bossType == "FINAL" and boss.hp <= boss.maxHp / 2 then
      moveSpeed = profile.EnragedMoveSpeed
    end

    boss.x = boss.x + boss.direction * moveSpeed
    local maximumX = GAME_CONFIG.LogicalWidth - boss.width
    if boss.x <= 0 then
      boss.x = 0
      boss.direction = 1
    elseif boss.x >= maximumX then
      boss.x = maximumX
      boss.direction = -1
    end

    boss.fireCooldown = boss.fireCooldown - 1
    if boss.fireCooldown <= 0 and state.player.alive then
      FireBossPattern(state, boss, profile)
      if boss.bossType == "FINAL" and boss.hp <= boss.maxHp / 2 then
        boss.fireCooldown = profile.EnragedFireIntervalTicks
      else
        boss.fireCooldown = profile.FireIntervalTicks
      end
    end
  end

  local function DefeatBoss(state)
    local boss = state.boss
    if not boss.active then
      return false
    end

    local profile = BOSS_PROFILES[boss.bossType]
    local leftX = boss.x + boss.width * 0.2 - GAME_CONFIG.ExplosionWidth / 2
    local rightX = boss.x + boss.width * 0.8 - GAME_CONFIG.ExplosionWidth / 2
    local centerX = boss.x + boss.width / 2 - GAME_CONFIG.ExplosionWidth / 2
    local upperY = boss.y + boss.height * 0.3 - GAME_CONFIG.ExplosionHeight / 2
    local centerY = boss.y + boss.height / 2 - GAME_CONFIG.ExplosionHeight / 2

    ScheduleExplosion(state, leftX, upperY, 0)
    ScheduleExplosion(state, rightX, upperY, 3)
    ScheduleExplosion(state, centerX, centerY, 6)
    ScheduleExplosion(state, centerX, centerY, 9)

    state.score = state.score + profile.Reward
    boss.active = false
    BeginStageClear(state)
    return true
  end
  local function BoxesOverlap(first, second)
    return first.x < second.x + second.width and
      first.x + first.width > second.x and
      first.y < second.y + second.height and
      first.y + first.height > second.y
  end

  local function ExplosionXForObject(object)
    return object.x + (object.width - GAME_CONFIG.ExplosionWidth) / 2
  end

  local function ExplosionYForObject(object)
    return object.y + (object.height - GAME_CONFIG.ExplosionHeight) / 2
  end

  local function KillPlayer(state)
    local player = state.player
    if not player.alive then
      return false
    end

    player.alive = false
    SpawnExplosion(
      state,
      ExplosionXForObject(player),
      ExplosionYForObject(player)
    )
    state.gameOver = true
    state.gameOverTicks = 0
    state.gameOverFrozen = false
    return true
  end

  local function CheckPlayerBulletEnemyCollisions(state)
    local profile = GetStageProfile(state)
    for bulletIndex = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[bulletIndex]
      if bullet.active then
        for enemyIndex = 1, GAME_CONFIG.MaxEnemies do
          local enemy = state.enemies[enemyIndex]
          if enemy.active and BoxesOverlap(bullet, enemy) then
            local explosionX = ExplosionXForObject(enemy)
            local explosionY = ExplosionYForObject(enemy)
            bullet.active = false
            SpawnExplosion(state, explosionX, explosionY)
            RecycleEnemy(state, enemy)
            state.score = state.score + profile.EnemyScore
            state.stageScore = state.stageScore + profile.EnemyScore
            break
          end
        end
      end
    end
  end

  local function CheckPlayerBulletBossCollisions(state)
    local boss = state.boss
    if not boss.active then
      return
    end

    for bulletIndex = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[bulletIndex]
      if bullet.active and BoxesOverlap(bullet, boss) then
        bullet.active = false
        boss.hp = boss.hp - 1
        if boss.hp <= 0 then
          boss.hp = 0
          DefeatBoss(state)
          return
        end
      end
    end
  end

  local function CheckEnemyBulletPlayerCollisions(state)
    if not state.player.alive then
      return
    end

    for bulletIndex = 1, GAME_CONFIG.MaxEnemyBullets do
      local bullet = state.enemyBullets[bulletIndex]
      if bullet.active and BoxesOverlap(bullet, state.player) then
        bullet.active = false
        KillPlayer(state)
        return
      end
    end
  end

  local function CheckEnemyPlayerCollisions(state)
    if not state.player.alive then
      return
    end

    for enemyIndex = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[enemyIndex]
      if enemy.active and BoxesOverlap(enemy, state.player) then
        local explosionX = ExplosionXForObject(enemy)
        local explosionY = ExplosionYForObject(enemy)

        if KillPlayer(state) then
          SpawnExplosion(state, explosionX, explosionY)
          RecycleEnemy(state, enemy)
        end
        return
      end
    end
  end

  local function CheckBossPlayerCollision(state)
    if not state.player.alive or not state.boss.active then
      return
    end

    if BoxesOverlap(state.boss, state.player) then
      KillPlayer(state)
    end
  end
  local PARALLAX_SVG_DEFINITIONS = table.concat({
    -- Easy: calm blue/white stars, tiny technical fragments, sparse cyan passes.
    "<g id=\"parallax_easy_star_dim\"><rect width=\"1\" height=\"1\" fill=\"#78bdf2\"/></g>",
    "<g id=\"parallax_easy_star_bright\"><circle cx=\"1\" cy=\"1\" r=\"1\" fill=\"#e8fbff\"/></g>",
    "<g id=\"parallax_easy_tech_a\"><rect width=\"5\" height=\"2\" fill=\"#55d9ff\"/><rect x=\"2\" y=\"-2\" width=\"1\" height=\"6\" fill=\"#8af4ff\"/></g>",
    "<g id=\"parallax_easy_tech_b\"><polygon points=\"0,2 3,0 7,2 3,4\" fill=\"#4a8fce\"/></g>",
    "<g id=\"parallax_easy_near_a\"><rect width=\"2\" height=\"12\" fill=\"#66f5ff\"/></g>",
    "<g id=\"parallax_easy_near_b\"><polygon points=\"0,0 5,2 2,7\" fill=\"#8fd9ed\"/></g>",

    -- Medium: purple/cyan stars plus visibly larger asteroid fragments.
    "<g id=\"parallax_medium_star_dim\"><rect width=\"1\" height=\"1\" fill=\"#9b64d9\"/></g>",
    "<g id=\"parallax_medium_star_bright\"><circle cx=\"1\" cy=\"1\" r=\"1\" fill=\"#61efff\"/></g>",
    "<g id=\"parallax_asteroid_small\"><polygon points=\"1,0 6,1 8,5 5,8 0,6\" fill=\"#70448f\" stroke=\"#b47ada\"/></g>",
    "<g id=\"parallax_asteroid_medium\"><polygon points=\"2,0 9,1 12,6 8,11 2,10 0,4\" fill=\"#4f315f\" stroke=\"#d052ad\"/></g>",
    "<g id=\"parallax_medium_near_rock\"><polygon points=\"2,0 11,2 14,8 8,12 0,9\" fill=\"#563260\" stroke=\"#ad62bd\"/></g>",
    "<g id=\"parallax_medium_particle\"><circle cx=\"2\" cy=\"2\" r=\"2\" fill=\"#ff54c8\"/></g>",

    -- Hard: dark mechanical debris and fast cyan/magenta energy fragments.
    "<g id=\"parallax_hard_star_dim\"><rect width=\"1\" height=\"1\" fill=\"#46506d\"/></g>",
    "<g id=\"parallax_hard_star_bright\"><rect width=\"2\" height=\"2\" fill=\"#ff4eb7\"/></g>",
    "<g id=\"parallax_hard_mech_a\"><path d=\"M0 1H9V4H6V7H2V4H0Z\" fill=\"#272d4f\" stroke=\"#4bd9e8\"/></g>",
    "<g id=\"parallax_hard_mech_b\"><rect width=\"11\" height=\"3\" fill=\"#39234e\"/><rect x=\"7\" y=\"3\" width=\"3\" height=\"5\" fill=\"#e348a5\"/></g>",
    "<g id=\"parallax_energy_streak\"><rect width=\"3\" height=\"18\" fill=\"#45f4ff\"/></g>",
    "<g id=\"parallax_data_fragment\"><rect width=\"7\" height=\"3\" fill=\"#ff4eb7\"/><rect x=\"2\" y=\"3\" width=\"2\" height=\"7\" fill=\"#6bdcff\"/></g>"
  })

  local PARALLAX_RENDER_PROFILES = {
    [1] = {
      Far = { "parallax_easy_star_dim", "parallax_easy_star_bright" },
      Mid = { "parallax_easy_tech_a", "parallax_easy_tech_b" },
      Near = { "parallax_easy_near_a", "parallax_easy_near_b" }
    },
    [2] = {
      Far = { "parallax_medium_star_dim", "parallax_medium_star_bright" },
      Mid = { "parallax_asteroid_small", "parallax_asteroid_medium" },
      Near = { "parallax_medium_near_rock", "parallax_medium_particle" }
    },
    [3] = {
      Far = { "parallax_hard_star_dim", "parallax_hard_star_bright" },
      Mid = { "parallax_hard_mech_a", "parallax_hard_mech_b" },
      Near = { "parallax_energy_streak", "parallax_data_fragment" }
    }
  }

  local function AppendParallaxLayer(parts, pool, maximum, definitions)
    for index = 1, maximum do
      local item = pool[index]
      if item.active then
        AppendDefinitionUse(
          parts,
          definitions[item.variant],
          item.x,
          item.y
        )
      end
    end
  end

  local function AppendFarParallax(parts, state)
    AppendParallaxLayer(
      parts,
      state.parallax.far,
      GAME_CONFIG.MaxFarParallax,
      PARALLAX_RENDER_PROFILES[state.stageIndex].Far
    )
  end

  local function AppendMidParallax(parts, state)
    AppendParallaxLayer(
      parts,
      state.parallax.mid,
      GAME_CONFIG.MaxMidParallax,
      PARALLAX_RENDER_PROFILES[state.stageIndex].Mid
    )
  end

  local function AppendNearParallax(parts, state)
    AppendParallaxLayer(
      parts,
      state.parallax.near,
      GAME_CONFIG.MaxNearParallax,
      PARALLAX_RENDER_PROFILES[state.stageIndex].Near
    )
  end
  local SVG_ROOT_OPEN =
    "<svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 320 480\" width=\"320\" height=\"480\" shape-rendering=\"crispEdges\">"

  -- The dynamic frame is intentionally transparent. Stage artwork lives in the
  -- low-frequency BackgroundViewport and is never copied into this prefix.
  local GAME_SVG_PREFIX = SVG_ROOT_OPEN .. "<defs>" ..
    DYNAMIC_GAMEPLAY_DEFINITIONS .. PARALLAX_SVG_DEFINITIONS .. "</defs>"

  local FALLBACK_BACKGROUND_COLORS = {
    [1] = "#083b69",
    [2] = "#32145f",
    [3] = "#090d2a"
  }

  local function BuildStageBackgroundSvg(stageIndex, scrollY)
    local profile = STAGE_PROFILES[stageIndex]
    local asset = ASSETS[profile.BackgroundAsset]
    local tileHeight = GAME_CONFIG.BackgroundTileHeight
    local offset = math.floor(scrollY) % tileHeight
    local parts = { SVG_ROOT_OPEN, "<defs>" }

    if asset ~= nil and asset.Available then
      parts[#parts + 1] = "<image id=\"stage_background_tile\" href=\"" ..
        asset.DataUri .. "\" width=\"320\" height=\"" ..
        tostring(tileHeight) .. "\" preserveAspectRatio=\"none\"/>"
    else
      parts[#parts + 1] = "<g id=\"stage_background_tile\"><rect width=\"320\" height=\"" ..
        tostring(tileHeight) .. "\" fill=\"" ..
        FALLBACK_BACKGROUND_COLORS[stageIndex] .. "\"/>"
      for index = 1, 28 do
        local x = (index * 47 + stageIndex * 19) % GAME_CONFIG.LogicalWidth
        local y = (index * 83 + stageIndex * 31) % tileHeight
        local size = 1 + (index % 2)
        parts[#parts + 1] = "<rect x=\"" .. tostring(x) .. "\" y=\"" ..
          tostring(y) .. "\" width=\"" .. tostring(size) .. "\" height=\"" ..
          tostring(size) .. "\" fill=\"#d7f7ff\"/>"
      end
      parts[#parts + 1] = "</g>"
    end

    parts[#parts + 1] = "</defs>"
    parts[#parts + 1] = "<use href=\"#stage_background_tile\" x=\"0\" y=\"" ..
      tostring(offset - tileHeight) .. "\"/>"
    parts[#parts + 1] = "<use href=\"#stage_background_tile\" x=\"0\" y=\"" ..
      tostring(offset) .. "\"/>"
    parts[#parts + 1] = "</svg>"
    return table.concat(parts), profile.BackgroundAsset
  end

  local function AppendEnemy(parts, state, enemy)
    AppendDefinitionUse(parts, GetStageProfile(state).EnemyDefinition, enemy.x, enemy.y)
  end

  local function AppendPlayerBullet(parts, bullet)
    AppendDefinitionUse(parts, "player_bullet_visible", bullet.x, bullet.y)
  end

  local function AppendEnemyBullet(parts, bullet)
    AppendDefinitionUse(parts, "enemy_bullet_visible", bullet.x, bullet.y)
  end

  local function AppendPlayer(parts, player)
    local renderX = player.x - math.floor(
      (GAME_CONFIG.PlayerRenderWidth - player.width) / 2
    )
    local renderY = player.y - (GAME_CONFIG.PlayerRenderHeight - player.height)
    AppendDefinitionUse(parts, ResolvePlayerDefinition(player.direction), renderX, renderY)
  end

  local function AppendExplosion(parts, explosion)
    local assetId = "explosion_0" .. tostring(explosion.frame)
    AppendSpriteUse(parts, assetId, "fallback_explosion", explosion.x, explosion.y)
  end

  local function AppendBoss(parts, boss)
    AppendDefinitionUse(parts, ResolveBossDefinition(boss.bossType), boss.x, boss.y)
  end

  local function AppendHud(parts, state)
    local profile = GetStageProfile(state)
    local scoreText = string.format("%06d", state.score)

    parts[#parts + 1] = "<rect x=\"0\" y=\"0\" width=\"320\" height=\"31\" fill=\"#07101f\"/>"
    parts[#parts + 1] = "<text x=\"7\" y=\"19\" fill=\"#46e6e1\" font-family=\"monospace\" font-size=\"10\">Q-SYS</text>"
    parts[#parts + 1] = "<text x=\"160\" y=\"19\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"10\" text-anchor=\"middle\">" ..
      state.stageName .. "</text>"
    parts[#parts + 1] = "<text x=\"313\" y=\"19\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"10\" text-anchor=\"end\">SCORE " ..
      scoreText .. "</text>"

    if state.stagePhase == "WAVE" and not state.gameOver then
      local progress = math.min(state.stageScore, profile.ScoreThreshold)
      parts[#parts + 1] = "<text x=\"160\" y=\"44\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"9\" text-anchor=\"middle\">" ..
        tostring(progress) .. " / " .. tostring(profile.ScoreThreshold) .. "</text>"
    elseif state.stagePhase == "BOSS" and state.boss.active then
      local hpWidth = math.floor(120 * state.boss.hp / state.boss.maxHp)
      parts[#parts + 1] = "<text x=\"160\" y=\"44\" fill=\"#ff9bd5\" font-family=\"monospace\" font-size=\"9\" text-anchor=\"middle\">" ..
        state.boss.label .. "</text>"
      parts[#parts + 1] = "<rect x=\"100\" y=\"50\" width=\"120\" height=\"7\" fill=\"#33142a\" stroke=\"#d7f7ff\"/>"
      parts[#parts + 1] = "<rect x=\"100\" y=\"50\" width=\"" ..
        tostring(hpWidth) .. "\" height=\"7\" fill=\"#ff3d9b\"/>"
    end
  end

  local function AppendCenteredOverlay(parts, title, score, prompt)
    parts[#parts + 1] = "<rect x=\"36\" y=\"184\" width=\"248\" height=\"116\" fill=\"#07101f\" stroke=\"#ff5c9d\"/>"
    parts[#parts + 1] = "<text x=\"160\" y=\"218\" fill=\"#ff5c9d\" font-family=\"monospace\" font-size=\"18\" text-anchor=\"middle\">" ..
      title .. "</text>"
    parts[#parts + 1] = "<text x=\"160\" y=\"250\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"11\" text-anchor=\"middle\">FINAL SCORE " ..
      string.format("%06d", score) .. "</text>"
    parts[#parts + 1] = "<text x=\"160\" y=\"278\" fill=\"#46e6e1\" font-family=\"monospace\" font-size=\"9\" text-anchor=\"middle\">" ..
      prompt .. "</text>"
  end

  local function BuildGameSvg(state)
    local parts = { GAME_SVG_PREFIX }

    AppendFarParallax(parts, state)
    AppendMidParallax(parts, state)
    AppendNearParallax(parts, state)

    for index = 1, GAME_CONFIG.MaxEnemies do
      local enemy = state.enemies[index]
      if enemy.active then
        AppendEnemy(parts, state, enemy)
      end
    end

    if state.boss.active then
      AppendBoss(parts, state.boss)
    end

    for index = 1, GAME_CONFIG.MaxEnemyBullets do
      local bullet = state.enemyBullets[index]
      if bullet.active then
        AppendEnemyBullet(parts, bullet)
      end
    end

    for index = 1, GAME_CONFIG.MaxPlayerBullets do
      local bullet = state.playerBullets[index]
      if bullet.active then
        AppendPlayerBullet(parts, bullet)
      end
    end

    for index = 1, GAME_CONFIG.MaxExplosions do
      local explosion = state.explosions[index]
      if explosion.active and explosion.delayTicks <= 0 then
        AppendExplosion(parts, explosion)
      end
    end

    if state.player.alive then
      AppendPlayer(parts, state.player)
    end

    AppendHud(parts, state)

    if state.gameOver then
      AppendCenteredOverlay(parts, "GAME OVER", state.score, "PRESS RUN TO RESTART")
    elseif state.gameClear then
      AppendCenteredOverlay(parts, "MISSION COMPLETE", state.score, "PRESS RUN TO RESTART")
    elseif state.paused then
      parts[#parts + 1] = "<rect x=\"78\" y=\"205\" width=\"164\" height=\"62\" fill=\"#07101f\" stroke=\"#f5a623\"/>"
      parts[#parts + 1] = "<text x=\"160\" y=\"244\" fill=\"#f5a623\" font-family=\"monospace\" font-size=\"18\" text-anchor=\"middle\">PAUSED</text>"
    elseif state.stagePhase == "CLEAR" then
      parts[#parts + 1] = "<rect x=\"60\" y=\"205\" width=\"200\" height=\"62\" fill=\"#07101f\" stroke=\"#46e6e1\"/>"
      parts[#parts + 1] = "<text x=\"160\" y=\"244\" fill=\"#46e6e1\" font-family=\"monospace\" font-size=\"18\" text-anchor=\"middle\">STAGE CLEAR</text>"
    elseif not state.running then
      parts[#parts + 1] = "<text x=\"160\" y=\"246\" fill=\"#d7f7ff\" font-family=\"monospace\" font-size=\"14\" text-anchor=\"middle\">PRESS RUN</text>"
    end

    parts[#parts + 1] = "</svg>"
    return table.concat(parts)
  end
  local rapidjson = require("rapidjson")

  local gameState = CreateGameState()
  local backgroundRenderCounter = 0
  local recentHorizontalIntent = 0
  local recentHorizontalTicks = 0
  local recentVerticalIntent = 0
  local recentVerticalTicks = 0
  local syntheticHorizontalIntent = 0
  local syntheticHorizontalHold = 0
  local syntheticVerticalIntent = 0
  local syntheticVerticalHold = 0

  GameLegend = {
    DrawChrome = false,
    IconData = ""
  }

  BackgroundLegend = {
    DrawChrome = false,
    IconData = ""
  }

  -- Keep the single timer globally scoped so Q-SYS Lua GC cannot remove it.
  GameTimer = Timer.New()

  local function RenderBackgroundFrame()
    local svg = BuildStageBackgroundSvg(
      gameState.stageIndex,
      gameState.backgroundScrollY
    )
    local rawBytes = #svg

    if rawBytes > GAME_CONFIG.MaxRawBackgroundSvgBytes then
      error(
        "Background SVG " .. tostring(rawBytes) .. " B > " ..
        tostring(GAME_CONFIG.MaxRawBackgroundSvgBytes) .. " B",
        0
      )
    end

    local encodedSvg = Crypto.Base64Encode(svg)
    BackgroundLegend.IconData = encodedSvg
    Controls.BackgroundViewport.Legend = rapidjson.encode(BackgroundLegend)
  end

  local function RenderGameFrame()
    local svg = BuildGameSvg(gameState)
    local rawBytes = #svg

    if rawBytes > GAME_CONFIG.MaxRawSvgBytes then
      error(
        "SVG " .. tostring(rawBytes) .. " B > " ..
        tostring(GAME_CONFIG.MaxRawSvgBytes) .. " B",
        0
      )
    end

    GameLegend.IconData = Crypto.Base64Encode(svg)
    Controls.Viewport.Legend = rapidjson.encode(GameLegend)
  end

  local function ResetCardinalChordAssist()
    recentHorizontalIntent = 0
    recentHorizontalTicks = 0
    recentVerticalIntent = 0
    recentVerticalTicks = 0
    syntheticHorizontalIntent = 0
    syntheticHorizontalHold = 0
    syntheticVerticalIntent = 0
    syntheticVerticalHold = 0
  end

  -- Mobile diagonals and the original physical/pin controls feed the same
  -- booleans. Returning scalars avoids allocating an input table every tick.
  local function ReadGameInput()
    local rawUp = Controls.Up.Boolean
    local rawDown = Controls.Down.Boolean
    local rawLeft = Controls.Left.Boolean
    local rawRight = Controls.Right.Boolean
    local diagonalUp = Controls.UpLeft.Boolean or Controls.UpRight.Boolean
    local diagonalDown = Controls.DownLeft.Boolean or Controls.DownRight.Boolean
    local diagonalLeft = Controls.UpLeft.Boolean or Controls.DownLeft.Boolean
    local diagonalRight = Controls.UpRight.Boolean or Controls.DownRight.Boolean
    local explicitDiagonal = diagonalUp or diagonalDown

    local horizontalIntent = 0
    if rawLeft then
      horizontalIntent = horizontalIntent - 1
    end
    if rawRight then
      horizontalIntent = horizontalIntent + 1
    end

    local verticalIntent = 0
    if rawUp then
      verticalIntent = verticalIntent - 1
    end
    if rawDown then
      verticalIntent = verticalIntent + 1
    end

    local anyHorizontal = rawLeft or rawRight
    local anyVertical = rawUp or rawDown

    if explicitDiagonal then
      ResetCardinalChordAssist()
    else
      -- A synthetic axis is valid only while the second, real axis remains
      -- held. Any real input on the synthetic axis replaces the latch.
      if syntheticHorizontalIntent ~= 0 and
          (verticalIntent ~= syntheticHorizontalHold or anyHorizontal) then
        syntheticHorizontalIntent = 0
        syntheticHorizontalHold = 0
      end
      if syntheticVerticalIntent ~= 0 and
          (horizontalIntent ~= syntheticVerticalHold or anyVertical) then
        syntheticVerticalIntent = 0
        syntheticVerticalHold = 0
      end

      -- Detect a cardinal slide only when the current axis is unambiguous and
      -- the orthogonal axis has fully released. True simultaneous inputs skip
      -- this path and resolve directly below.
      if syntheticHorizontalIntent == 0 and not anyHorizontal and
          verticalIntent ~= 0 and recentHorizontalTicks > 0 then
        syntheticHorizontalIntent = recentHorizontalIntent
        syntheticHorizontalHold = verticalIntent
      end
      if syntheticVerticalIntent == 0 and not anyVertical and
          horizontalIntent ~= 0 and recentVerticalTicks > 0 then
        syntheticVerticalIntent = recentVerticalIntent
        syntheticVerticalHold = horizontalIntent
      end

      -- Only a solo cardinal press opens a grace window. Seeing both axes at
      -- once proves true simultaneous input and clears stale detection state.
      if horizontalIntent ~= 0 and not anyVertical then
        recentHorizontalIntent = horizontalIntent
        recentHorizontalTicks = GAME_CONFIG.CardinalChordGraceTicks
      elseif anyHorizontal then
        recentHorizontalIntent = 0
        recentHorizontalTicks = 0
      elseif recentHorizontalTicks > 0 then
        recentHorizontalTicks = recentHorizontalTicks - 1
        if recentHorizontalTicks <= 0 then
          recentHorizontalIntent = 0
        end
      end

      if verticalIntent ~= 0 and not anyHorizontal then
        recentVerticalIntent = verticalIntent
        recentVerticalTicks = GAME_CONFIG.CardinalChordGraceTicks
      elseif anyVertical then
        recentVerticalIntent = 0
        recentVerticalTicks = 0
      elseif recentVerticalTicks > 0 then
        recentVerticalTicks = recentVerticalTicks - 1
        if recentVerticalTicks <= 0 then
          recentVerticalIntent = 0
        end
      end
    end

    local up = rawUp or diagonalUp or syntheticVerticalIntent < 0
    local down = rawDown or diagonalDown or syntheticVerticalIntent > 0
    local left = rawLeft or diagonalLeft or syntheticHorizontalIntent < 0
    local right = rawRight or diagonalRight or syntheticHorizontalIntent > 0
    local fire = Controls.Fire.Boolean or Controls.AutoFire.Boolean

    return up, down, left, right, fire
  end

  local function UpdateGameState()
    if not gameState.running or gameState.paused then
      return
    end

    UpdateParallax(gameState)

    if gameState.gameOver then
      AdvanceGameOverAnimation(gameState)
      return
    end

    if gameState.stagePhase == "CLEAR" then
      UpdateExplosions(gameState)
      local nextStage = AdvanceStageClear(gameState)
      if nextStage ~= nil then
        ResetEnemies(gameState)
        ResetParallax(gameState, nextStage)
        backgroundRenderCounter = 0
        RenderBackgroundFrame()
      end
      return
    end

    local upPressed, downPressed, leftPressed, rightPressed, firePressed =
      ReadGameInput()

    UpdatePlayer(
      gameState,
      leftPressed,
      rightPressed,
      upPressed,
      downPressed
    )

    UpdatePlayerBurstState(gameState)

    if firePressed then
      FirePlayerBullet(gameState)
    end

    UpdatePlayerBullets(gameState)
    if gameState.stagePhase == "WAVE" then
      UpdateEnemies(gameState)
      UpdateEnemyFire(gameState)
    elseif gameState.stagePhase == "BOSS" then
      UpdateBoss(gameState)
    end
    UpdateEnemyBullets(gameState)

    if gameState.stagePhase == "WAVE" then
      CheckPlayerBulletEnemyCollisions(gameState)
    elseif gameState.stagePhase == "BOSS" then
      CheckPlayerBulletBossCollisions(gameState)
    end
    CheckEnemyBulletPlayerCollisions(gameState)
    if gameState.stagePhase == "WAVE" then
      CheckEnemyPlayerCollisions(gameState)
    elseif gameState.stagePhase == "BOSS" then
      CheckBossPlayerCollision(gameState)
    end

    if gameState.gameOver then
      AdvanceGameOverAnimation(gameState)
      return
    end


    if gameState.stagePhase == "WAVE" and StageThresholdReached(gameState) then
      BeginBossPhase(gameState)
      SpawnBoss(gameState)
    elseif gameState.stagePhase == "CLEAR" then
      UpdateExplosions(gameState)
      return
    end

    UpdateExplosions(gameState)
    gameState.ticks = gameState.ticks + 1
    gameState.time = gameState.ticks * GAME_CONFIG.UpdateInterval
  end

  local function StartGame()
    GameTimer:Stop()
    ResetCardinalChordAssist()
    Controls.Pause.Boolean = false
    ResetGameState(gameState)
    EnterStage(gameState, 1)
    ResetEnemies(gameState)
    ResetParallax(gameState, 1)
    gameState.running = true
    gameState.paused = false
    backgroundRenderCounter = 0
    RenderBackgroundFrame()
    RenderGameFrame()
    GameTimer:Start(GAME_CONFIG.UpdateInterval)
  end

  local function StopGame()
    GameTimer:Stop()
    ResetCardinalChordAssist()
    gameState.running = false
    gameState.paused = false
    Controls.Pause.Boolean = false
  end

  local function PauseGame()
    if not gameState.running or gameState.gameOver or gameState.gameClear then
      Controls.Pause.Boolean = false
      return
    end

    GameTimer:Stop()
    gameState.paused = true
    RenderGameFrame()
  end

  local function ResumeGame()
    if not gameState.running then
      Controls.Pause.Boolean = false
      return
    end

    ResetCardinalChordAssist()
    gameState.paused = false
    backgroundRenderCounter = 0
    RenderBackgroundFrame()
    RenderGameFrame()
    GameTimer:Start(GAME_CONFIG.UpdateInterval)
  end

  GameTimer.EventHandler = function()
    UpdateGameState()
    UpdateBackgroundScroll(gameState)

    backgroundRenderCounter = backgroundRenderCounter + 1
    if backgroundRenderCounter >= GAME_CONFIG.BackgroundRenderDivider then
      backgroundRenderCounter = 0
      RenderBackgroundFrame()
    end

    RenderGameFrame()
  end

  Controls.Run.EventHandler = function(control)
    if control.Boolean then
      StartGame()
      control.Boolean = false
    end
  end

  Controls.Pause.EventHandler = function(control)
    if not gameState.running or gameState.gameOver or gameState.gameClear then
      control.Boolean = false
      return
    end

    if control.Boolean then
      PauseGame()
    else
      ResumeGame()
    end
  end

  ResetGameState(gameState)
  EnterStage(gameState, 1)
  ResetEnemies(gameState)
  ResetParallax(gameState, 1)
  ResetCardinalChordAssist()
  GameTimer:Stop()
  Controls.Run.Boolean = false
  Controls.Pause.Boolean = false
  backgroundRenderCounter = 0
  RenderBackgroundFrame()
  RenderGameFrame()

  local missingAssets = MissingAssetList()
  if missingAssets ~= "" then
    print("[f5Rocket] Missing PNG assets; definition-based SVG fallbacks active: " .. missingAssets)
  end
end
